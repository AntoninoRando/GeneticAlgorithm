// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
	"name": "C++",
	"build": {
		"dockerfile": "Dockerfile"
	},

	// Runs once when the container is first created. Installs the Python
	// libraries main.py needs (numpy, matplotlib), the pybind11/Python build
	// headers + debug tooling, and builds the native "scheduler" module so the
	// project is runnable immediately. See .devcontainer/postCreate.sh.
	"postCreateCommand": "bash .devcontainer/postCreate.sh",

	// Extensions installed automatically inside the container.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"ms-vscode.cmake-tools"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
