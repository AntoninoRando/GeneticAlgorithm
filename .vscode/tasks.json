{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build scheduler module (Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug -DPYTHON_EXECUTABLE=$(which python3) && cmake --build build --target scheduler"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "python3 -m unittest discover -s tests -v"
      ],
      "group": "test",
      "dependsOn": "Build scheduler module (Debug)",
      "problemMatcher": []
    }
  ]
}
