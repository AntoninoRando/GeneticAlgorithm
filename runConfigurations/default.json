{
    "generations":          500,
    "population_size":      30,
    "max_depth":            4,
    "hoist_rate":           0.05,
    "convergence_threshold": 10,
    "csv_row_limit":        200,
    "metrics_dir":          "metrics",
    "metrics_prefix":       "",
    "metrics_flush_every":  1,
    "collect_metrics":      false,
    "inspect_snapshots":    false,
    "save_snapshots":       false,
    "snapshots_dir":        "snapshots",
    "snapshots_prefix":     "",
    "print_every":          50,
    

    "jobsCSV": {
        "IgnoredColumns": [
            "Task ID",
            "Status",
            "Arrival Time (System)",
            "Arrival Time (Queue)",
            "Start Time",
            "End Time",
            "Time in system",
            "Server Name",
            "Exec_after_set",
            "Remaining_energy [%]",
            "Rejection Reason",
            "Routing Init Time",
            "Routing End Time"
        ]
    }
}
